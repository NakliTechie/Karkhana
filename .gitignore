# Whitelist-style: nothing is tracked unless it is named here. The build output
# is hundreds of megabytes, so an allow-list is the only safe default.
*
!.gitattributes
!.gitignore
!README.md
!ROADMAP.md
!NEXT-SESSION.md
!CONTRIBUTING.md
!LICENSE
!_headers
!_redirects
!404.html

# The shipped 64-bit engine, served at the apex. The engine is chunked into
# <20MB parts because Cloudflare Pages caps a single file at 25MB; the page
# reassembles them in memory. The repo is the only artifact store.
!index.html
!karkhana-sw.js
!load.js
!out.js
!arg-module.js
!browser-fetch.js
!pypi-metadata.js
!egress.js
!kfetch.py
!kpip_fast.py
!karkhana-tty.sh
!opfs-disk.js
!opfs-disk-worker.js
!mem-disk.js
!machine-file.js
!chunk-tracker.js
!replica.js
!replica-worker.js
!backup.js
!kdisk.qcow2.gz
!c2w-net-proxy.wasm.gzip
!engine/
!engine/**
!dist/
dist/*
!dist/stack.js
!dist/stack-worker.js
!vendor/
vendor/*
!vendor/xterm.js
!vendor/xterm.css
!vendor/xterm-pty.js

