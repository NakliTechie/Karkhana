# Whitelist-style: nothing is tracked unless it is named here. The build output
# is hundreds of megabytes, so an allow-list is the only safe default.
*
!.gitattributes
!.gitignore
!README.md
!ROADMAP.md
!NEXT-SESSION.md
!CONTRIBUTING.md
!LICENSE
!_headers

# The shipped 64-bit engine, served at the apex. The engine is chunked into
# <20MB parts because Cloudflare Pages caps a single file at 25MB; the page
# reassembles them in memory. The repo is the only artifact store.
!index.html
!karkhana-sw.js
!load.js
!out.js
!arg-module.js
!c2w-net-proxy.wasm.gzip
!engine/
!engine/**
!dist/
dist/*
!dist/stack.js
!dist/stack-worker.js
!vendor/
vendor/*
!vendor/xterm.js
!vendor/xterm.css
!vendor/xterm-pty.js

# qemu-wasm build (recipe tracked; 600MB+ output bundles rebuilt via qemu-build/build.sh)
!qemu-build/
qemu-build/*
!qemu-build/Dockerfile.guest
!qemu-build/Dockerfile.builder
!qemu-build/README.md
!qemu-build/build.sh
!qemu-build/run-build.sh
!qemu-build/chunk.sh
!qemu-build/publish.sh
!qemu-build/karkhana.html
!qemu-build/serve.py
!qemu-build/karkhana-sw.js
!qemu-build/guest/
qemu-build/guest/*
!qemu-build/guest/agent.py
!qemu-build/vendor/
qemu-build/vendor/*
!qemu-build/vendor/xterm.js
!qemu-build/vendor/xterm.css
!qemu-build/vendor/xterm-pty.js
!qemu-build/net/
qemu-build/net/*
!qemu-build/net/c2w-net-proxy/
qemu-build/net/c2w-net-proxy/*
!qemu-build/net/c2w-net-proxy/main.go
!qemu-build/net/c2w-net-proxy/go.mod
!qemu-build/net/c2w-net-proxy/go.sum
!qemu-build/net/c2w-net-proxy/README.md
!qemu-build/net/stack/
qemu-build/net/stack/*
!qemu-build/net/stack/stack.js
!qemu-build/net/stack/stack-worker.js
!qemu-build/net/stack/wasi-util.js
!qemu-build/net/stack/package.json
!qemu-build/net/stack/webpack.config.js
!qemu-build/net/stack/tsconfig.json
